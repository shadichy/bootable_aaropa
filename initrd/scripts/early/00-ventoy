# Overrides find_root
_find_root_ventoy() {
	for _s in $(seq 0 "$ROOTWAIT"); do
		# If is booting from Ventoy GRUB2 Mode
		"$VTOY_PATH/hook/android/ventoy-disk.sh"

		[ -e "$ROOT" ] && break
		sleep 1
	done
}

run() {
	[ -d "$VTOY_PATH" ] || return 0
	export \
		HAS_VTOY=1 \
		ROOT=/dev/mapper/ventoy \
		find_root=_find_root_ventoy
}
