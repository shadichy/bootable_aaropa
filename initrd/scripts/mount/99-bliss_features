internal_mount() {
  [ "${INTERNAL_MOUNT:=0}" -gt "0" ] || return 0
  export REAL_FSTAB=/system/vendor/etc/fstab.internal.x86

  echo '# WARNING: INTERNAL_MOUNT option is enabled, all the internal partitions'
  echo '# will now be recognized as USBs if the supported filesystem is available'
  echo '# and will create empty directories like Android, DCIM, Documents, etc.'
  echo ''
  echo '# DO NOT PRESS "TAP TO FIX", IT WILL FORMAT THE DRIVE!'
}

pc_mode() {
  [ "$PC_MODE" -gt "0" ] || return 0
  mount --bind /system/etc/hidden_xml/pc.xml /system/etc/permissions/pc.xml

  echo '# WARNING: PC_MODE will not work once Magisk or KernelSU modules are installed.'
  echo '# Visit BlissOS wiki for more info & solutions'
}

hpe() {
  [ "$HPE" -gt "0" ] || return 0
  mount --bind /system/etc/hidden_xml/hpe.xml /system/etc/sysconfig/hpe.xml

  echo '# WARNING: HPE will not work once Magisk or KernelSU modules are installed.'
  echo '# Visit BlissOS wiki for more info & solutions'
}

bt_ble_disable() {
  [ "$BT_BLE_DISABLE" -ge "1" ] || return 0

  cat <<EOF >/tmp/noble.xml
<?xml version="1..0" encoding="utf-8"?>
<permissions>
</permissions>
EOF

  mount --bind /tmp/noble.xml /system/vendor/etc/permissions/android.hardware.bluetooth_le.xml

  echo '# NOTICE: BLE is set to be disabled'

}

bliss_feature() {
  internal_mount
  pc_mode
  hpe
  bt_ble_disable
}

run() {
  # If neither RCVRY nor INSTALL is specified
  [ "$RCVRY" ] || [ "$INSTALL" ] || bliss_feature
}
