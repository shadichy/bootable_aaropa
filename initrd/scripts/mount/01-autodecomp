auto_decomp() {
	local file="$1" out="$2"
	[ -f "$file" ] || return 1

	# Supported (de)compressors: gunzip, bzcat, xzcat, lzcat, zcat
	false ||
		gunzip -c "$file" >"$out" ||
		bzcat "$file" >"$out" ||
		xzcat "$file" >"$out" ||
		lzcat "$file" >"$out" ||
		zcat "$file" >"$out" ||
		return 2
}