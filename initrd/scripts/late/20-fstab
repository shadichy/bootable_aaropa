link_fstab() {
	local root_fstab fstab fstab_tr=/tmp/fstab.real
	root_fstab=$(find "$SWITCH_DEST" -mindepth 1 -maxdepth 1 -type f -iname 'fstab.*' -print -quit)
	fstab=${REAL_FSTAB:-$root_fstab}

	cat "$fstab" >>$fstab_tr
	mount --bind $fstab_tr "$fstab"

	[ "$REAL_FSTAB" ] && mount --bind $fstab_tr "$root_fstab"
}

run() {
	link_fstab
}
