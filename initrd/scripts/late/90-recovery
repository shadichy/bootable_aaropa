mount_recovery() {
	if [ -d /recovery/data/cache ]; then
		ln -s /data/cache /recovery/cache
	fi
}

post_setup_recovery() {
	umount-r -f /android
}

run() {
	[ "$RCVRY" ] || return 0
	mount_recovery
	post_setup_recovery
}
